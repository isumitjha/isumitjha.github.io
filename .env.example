# Copy to .env for LOCAL stats generation (never commit .env — it's gitignored).
# In production these come from GitHub Actions secrets, not this file.

# Recommended: a FINE-GRAINED PAT, read-only, with:
#   Repository access: All repositories
#   Repository permissions: Contents -> Read-only, Metadata -> Read-only
# (Classic token with scopes `repo` + `read:user` also works, but is broader.)
# Give it an expiry and rotate it. Never commit this file.
GH_TOKEN=github_pat_your_token_here

# Your GitHub username
GH_USER=isumitjha
